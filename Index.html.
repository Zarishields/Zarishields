    'ZS-2002-BBBB': { status: 'warn', product: 'Night Care Maxi, 10 pads', maker: 'Demo Manufacturer Ltd', batch: 'B-2311', made: 'Nov 2025', exp: 'Nov 2028', checks: 41 }
  };
  var PH = [
    { v: 4, c: '#E9B44C', t: '#1B1B1B' }, { v: 5, c: '#C9CF4A', t: '#1B1B1B' }, { v: 6, c: '#7DBF6B', t: '#1B1B1B' },
    { v: 7, c: '#3FA37F', t: '#1B1B1B' }, { v: 8, c: '#2F7FA8', t: '#FFFFFF' }, { v: 9, c: '#5A5CA8', t: '#FFFFFF' }
  ];
  var state = { code: null, ph: null };
  var ussdState = null;

  function normalize(raw) {
    var s = String(raw).toUpperCase().replace(/[^A-Z0-9]/g, '');
    if (s.length === 10 && s.indexOf('ZS') === 0) return 'ZS-' + s.slice(2, 6) + '-' + s.slice(6);
    return String(raw).trim().toUpperCase();
  }
  function lookup(raw) { var c = normalize(raw); return { c: c, rec: DB[c] || null }; }
  function ref() { return 'ZR-' + (10000 + Math.floor(Math.random() * 89999)); }
  function phInRange(v) { return v >= 4.5 && v <= 7; }

  var ICON = { ok: 'i-check', warn: 'i-alert', bad: 'i-x' };
  function resultHtml(kind, title, body) {
    return '<div class="result ' + kind + '" role="status"><div class="r-head"><svg class="ico"><use href="#' + ICON[kind] + '"/></svg>' + title + '</div>' + body + '</div>';
  }

  /* Navigation */
  function go(name) {
    $$('.screen[data-screen]').forEach(function (s) { s.hidden = s.dataset.screen !== name; });
    $$('.nav button').forEach(function (b) {
      if (b.dataset.go === name) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
    });
    $('#screens').scrollTop = 0;
    if (name === 'home') renderHome();
    if (name === 'ph') renderVerdict('#phVerdict');
  }
  document.addEventListener('click', function (e) {
    var g = e.target.closest('[data-go]');
    if (g) { go(g.dataset.go); return; }
    var f = e.target.closest('[data-fill]');
    if (f) { $('#code').value = f.dataset.fill; go('check'); showCheck(f.dataset.fill); return; }
    var s = e.target.closest('[data-sms]');
    if (s) { sendSms(s.dataset.sms); }
  });

  /* Combined verdict */
  function verdict() {
    if (!state.code || !state.ph) return null;
    if (state.code === 'bad') return { k: 'bad', t: 'Do not use this pack', d: 'The code was not found in the register. Report the pack so others are warned.' };
    if (!state.ph.inRange) return { k: 'bad', t: 'Do not use this pack', d: 'The pH reading is outside the expected range. Report the pack so others are warned.' };
    if (state.code === 'warn') return { k: 'warn', t: 'Use with caution', d: 'The pH is in range, but this code has been checked many times and may be a copied label. Report it.' };
    return { k: 'ok', t: 'Looks safe to use', d: 'The code matches a registered batch and the pH is in the expected range.' };
  }
  function renderVerdict(sel) {
    var v = verdict();
    $(sel).innerHTML = v ? resultHtml(v.k, v.t, '<p>' + v.d + '</p>') : '';
  }

  /* Home */
  function renderHome() {
    var codeMap = { ok: ['ok', 'Verified'], warn: ['warn', 'Check with care'], bad: ['bad', 'Not found'] };
    var c = state.code ? codeMap[state.code] : ['none', 'Not done'];
    var p = state.ph ? (state.ph.inRange ? ['ok', 'In range, pH ' + state.ph.v] : ['bad', 'Out of range, pH ' + state.ph.v]) : ['none', 'Not done'];
    $('#homeStatus').innerHTML =
      '<div class="row"><span>Pack code</span><span class="chip ' + c[0] + '">' + c[1] + '</span></div>' +
      '<div class="row"><span>pH strip</span><span class="chip ' + p[0] + '">' + p[1] + '</span></div>';
    renderVerdict('#homeVerdict');
  }
  $('#startOver').addEventListener('click', function () {
    state = { code: null, ph: null };
    $('#code').value = '';
    $('#checkResult').innerHTML = '';
    $('#phResult').innerHTML = '';
    $$('.sw').forEach(function (b) { b.setAttribute('aria-pressed', 'false'); });
    renderHome();
  });

  /* Code check */
  function showCheck(raw) {
    var out = $('#checkResult');
    if (!String(raw).trim()) { out.innerHTML = '<p class="err" role="alert">Enter the code printed on the pack.</p>'; return; }
    var r = lookup(raw), c = esc(r.c), rec = r.rec;
    var next = '<button class="btn" data-go="ph">Next: test with the pH strip</button>';
    if (!rec) {
      state.code = 'bad';
      out.innerHTML = resultHtml('bad', 'Code not found',
        '<p>' + c + ' is not in the register. Check the digits again. If they are right, do not use this pack.</p>' +
        '<button class="btn" id="reportThis">Report this pack</button>');
    } else if (rec.status === 'warn') {
      state.code = 'warn';
      out.innerHTML = resultHtml('warn', 'Check with care',
        '<p>This code has been checked ' + rec.checks + ' times. A genuine code should be checked only a few times, so the label may be copied.</p>' +
        details(c, rec) + next + '<button class="btn" id="reportThis">Report this pack</button>');
    } else {
      state.code = 'ok';
      out.innerHTML = resultHtml('ok', 'Verified',
        '<p>This code matches a registered batch. It has been checked ' + rec.checks + ' times.</p>' + details(c, rec) + next);
    }
    var rb = $('#reportThis');
    if (rb) rb.addEventListener('click', function () { $('#rCode').value = r.c; go('report'); });
  }
  function details(c, rec) {
    return '<dl class="kv"><dt>Code</dt><dd>' + c + '</dd><dt>Product</dt><dd>' + rec.product + '</dd><dt>Maker</dt><dd>' + rec.maker + '</dd><dt>Batch</dt><dd>' + rec.batch + '</dd><dt>Made</dt><dd>' + rec.made + '</dd><dt>Expires</dt><dd>' + rec.exp + '</dd></dl>';
  }
  $('#checkForm').addEventListener('submit', function (e) { e.preventDefault(); showCheck($('#code').value); });

  /* pH strip */
  var sws = $('#swatches');
  PH.forEach(function (p) {
    var b = document.createElement('button');
    b.className = 'sw'; b.type = 'button';
    b.style.background = p.c; b.style.color = p.t;
    b.textContent = p.v; b.setAttribute('aria-label', 'pH ' + p.v); b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', function () { choosePh(p.v); });
    sws.appendChild(b);
  });
  function choosePh(v) {
    var ok = phInRange(v);
    state.ph = { v: v, inRange: ok };
    $$('.sw').forEach(function (b) { b.setAttribute('aria-pressed', String(b.textContent === String(v))); });
    $('#phResult').innerHTML = ok
      ? resultHtml('ok', 'Inside the expected range', '<p>pH ' + v + ' is within the demo range of 4.5 to 7.0.</p>')
      : resultHtml('bad', 'Outside the expected range', '<p>pH ' + v + ' is ' + (v < 4.5 ? 'too acidic' : 'too alkaline') + '. Do not use this pack. Report it so others are warned.</p><button class="btn" data-go="report">Report this pack</button>');
    renderVerdict('#phVerdict');
  }

  /* SMS */
  var thread = $('#thread');
  function bubble(txt, cls) {
    var d = document.createElement('div'); d.className = 'bubble ' + cls; d.textContent = txt;
    thread.appendChild(d); thread.scrollTop = thread.scrollHeight;
  }
  function smsReply(msg) {
    var m = msg.trim(), mm;
    if ((mm = m.match(/^CHECK\s+(.+)$/i))) {
      var r = lookup(mm[1]);
      if (!r.rec) return 'Zarishields: ' + r.c + ' not found. Re-check the digits. If right, do not use this pack. Text REPORT ' + r.c + '.';
      if (r.rec.status === 'ok') return 'Zarishields: ' + r.c + ' VERIFIED. ' + r.rec.product + ', batch ' + r.rec.batch + '. Next, test the pH strip and text PH followed by the number.';
      return 'Zarishields: CAUTION. ' + r.c + ' checked ' + r.rec.checks + ' times, may be copied. Do not use. Text REPORT ' + r.c + '.';
    }
    if ((mm = m.match(/^PH\s+([0-9]+(?:\.[0-9])?)$/i))) {
      var v = parseFloat(mm[1]);
      return phInRange(v) ? 'Zarishields: pH ' + v + ' is in the expected range (demo 4.5 to 7.0).' : 'Zarishields: pH ' + v + ' is OUTSIDE the expected range. Do not use this pack. Text REPORT and the code.';
    }
    if (/^REPORT\b/i.test(m)) return 'Zarishields: report received. Ref ' + ref() + '. Thank you. Demo only, nothing was stored.';
    return 'Zarishields: text CHECK code, PH number, or REPORT code. Example: CHECK ZS-1001-AAAA';
  }
  function sendSms(msg) {
    if (!msg.trim()) return;
    bubble(msg.trim(), 'out');
    setTimeout(function () { bubble(smsReply(msg), 'in'); }, 500);
  }
  $('#smsForm').addEventListener('submit', function (e) { e.preventDefault(); var i = $('#smsInput'); sendSms(i.value); i.value = ''; });
  bubble('Text CHECK followed by the pack code to 30777. Example: CHECK ZS-1001-AAAA', 'in');

  /* USSD */
  var MENU = 'Zarishields\n1. Check pack code\n2. Check pH strip result\n3. Report a fake\n0. Exit';
  var ussdBox = $('#ussd'), ussdText = $('#ussdText'), ussdIn = $('#ussdIn');
  function say(t) { ussdText.textContent = t; }
  function ussdClose() { ussdBox.hidden = true; ussdState = null; }
  $('#dialBtn').addEventListener('click', function () { ussdState = 'menu'; ussdBox.hidden = false; say(MENU); ussdIn.value = ''; ussdIn.focus(); });
  $('#ussdCancel').addEventListener('click', ussdClose);
  function ussdSend() {
    var v = ussdIn.value.trim(); ussdIn.value = '';
    if (!v) return;
    if (ussdState === 'menu') {
      if (v === '1') { ussdState = 'code'; say('Enter the pack code.\nExample: ZS-1001-AAAA'); }
      else if (v === '2') { ussdState = 'ph'; say('Enter the pH number you matched on the strip (4 to 9).'); }
      else if (v === '3') { ussdState = 'rep'; say('Enter the pack code or product name to report.'); }
      else if (v === '0') { ussdClose(); }
      else { say('Invalid choice.\n\n' + MENU); }
    } else if (ussdState === 'code') {
      var r = lookup(v);
      if (!r.rec) say(r.c + '\nNOT FOUND\nRe-check the digits. If right, do not use this pack.\n\n0. Menu');
      else if (r.rec.status === 'ok') say(r.c + '\nVERIFIED\n' + r.rec.product + '\nBatch ' + r.rec.batch + '\n\n0. Menu');
      else say(r.c + '\nCAUTION\nChecked ' + r.rec.checks + ' times. May be copied. Do not use.\n\n0. Menu');
      ussdState = 'after';
    } else if (ussdState === 'ph') {
      var n = parseFloat(v);
      if (isNaN(n) || n < 3 || n > 10) say('Enter a number between 4 and 9.');
      else { say('pH ' + n + '\n' + (phInRange(n) ? 'In the expected range.' : 'OUTSIDE the expected range. Do not use this pack.') + '\n\n0. Menu'); ussdState = 'after'; }
    } else if (ussdState === 'rep') {
      say('Report received.\nRef ' + ref() + '\nThank you.\n\n0. Menu'); ussdState = 'after';
    } else if (ussdState === 'after') {
      if (v === '0') { ussdState = 'menu'; say(MENU); } else say('0. Menu');
    }
  }
  $('#ussdSend').addEventListener('click', ussdSend);
  ussdIn.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); ussdSend(); } });

  /* SMS / USSD toggle */
  function seg(which) {
    var sms = which === 'sms';
    $('#panelSms').hidden = !sms; $('#panelUssd').hidden = sms;
    $('#segSms').setAttribute('aria-pressed', String(sms)); $('#segUssd').setAttribute('aria-pressed', String(!sms));
  }
  $('#segSms').addEventListener('click', function () { seg('sms'); });
  $('#segUssd').addEventListener('click', function () { seg('ussd'); });

  /* Report */
  $('#reportForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var has = $('#rCode').value.trim() || $('#rProduct').value.trim();
    $('#rErr').hidden = !!has;
    if (!has) return;
    $('#refNo').textContent = ref();
    $('#reportForm').hidden = true; $('#reportDone').hidden = false;
    $('#screens').scrollTop = 0;
  });
  $('#reportAgain').addEventListener('click', function () {
    $('#reportForm').reset(); $('#reportForm').hidden = false; $('#reportDone').hidden = true;
  });

  go('home');
})();
</script>

</body>
</html>
